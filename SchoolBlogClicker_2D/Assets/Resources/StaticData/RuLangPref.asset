    UpgradeIncomeTexts:
    - Title: "\u0427\u0430\u0442 \u043A\u043B\u0430\u0441\u0441\u0430"
      Description: "\u041E\u0434\u043D\u043E\u043A\u043B\u0430\u0441\u0441\u043D\u0438\u043A\u0438
        \u0434\u0435\u043B\u044F\u0442\u0441\u044F \u043F\u043E\u0441\u0442\u0430\u043C\u0438."
    - Title: "\u0428\u043A\u043E\u043B\u044C\u043D\u0430\u044F \u0433\u0430\u0437\u0435\u0442\u0430"
      Description: "\u041D\u043E\u0432\u044B\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0438
        \u043F\u0440\u0438\u0432\u043E\u0434\u044F\u0442 \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u0435\u0439."
    - Title: "\u041C\u0435\u0434\u0438\u0430\u043A\u0440\u0443\u0436\u043E\u043A"
      Description: "\u041A\u0440\u0443\u0436\u043E\u043A \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
        \u0440\u043E\u043B\u0438\u043A\u0438."
    - Title: "\u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u043C\u043E\u043D\u0442\u0430\u0436\u0430"
      Description: "\u041C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u044B \u0433\u043E\u0442\u043E\u0432\u044F\u0442
        \u043D\u043E\u0432\u044B\u0435 \u0432\u0438\u0434\u0435\u043E."
    - Title: "\u0428\u043A\u043E\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0434\u043A\u0430\u0441\u0442"
      Description: "\u0412\u044B\u043F\u0443\u0441\u043A\u0438 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u044E\u0442
        \u0441\u043B\u0443\u0448\u0430\u0442\u0435\u043B\u0435\u0439."
    - Title: "\u0421\u043F\u043E\u043D\u0441\u043E\u0440\u0441\u043A\u0430\u044F
        \u0432\u0441\u0442\u0430\u0432\u043A\u0430"
      Description: "\u041F\u0430\u0440\u0442\u043D\u0451\u0440\u044B \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442
        \u0440\u043E\u043B\u0438\u043A\u0438."
    - Title: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E \u0431\u043B\u043E\u0433\u0435\u0440\u043E\u0432"
      Description: "\u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u0438\u0449\u0435\u0442
        \u0440\u0435\u043A\u043B\u0430\u043C\u043E\u0434\u0430\u0442\u0435\u043B\u0435\u0439."
    - Title: "\u041C\u0435\u0434\u0438\u0430\u0441\u0435\u0442\u044C"
      Description: "\u041A\u0430\u043D\u0430\u043B\u044B-\u043F\u0430\u0440\u0442\u043D\u0451\u0440\u044B
        \u0434\u0435\u043B\u044F\u0442\u0441\u044F \u0432\u0438\u0434\u0435\u043E."
